{
  "name": "dsh-aurabot-qq",
  "version": "1.5.2",
  "description": "Aurabot for macOS：aureth-labs/dsh-aurabot-qq 的 macOS（Apple 芯片）分叉 —— DeepSeek Harness 的 QQ 机器人插件「大肥鱼」（经 OneBot v11 接 QQ）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./mind": "./src/mind/index.js",
    "./mind/replay": "./src/mind/replay.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "mind:replay": "node scripts/replay-mind.js",
    "mind:privacy": "node scripts/replay-privacy.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot"
  ],
  "files": [
    "src",
    "scripts/replay-mind.js",
    "scripts/replay-privacy.js",
    "scripts/mind-replay-report.js",
    "models",
    "THIRD-PARTY-NOTICES.md",
    "client",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/USER-MANUAL.md",
    "docs/MODULE-TUTORIAL.md",
    "LICENSE",
    "CHANGELOG.md",
    "README_EN.md",
    "docs/DESIGN.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Geng-zy/aurabot-qq-mac.git"
  },
  "homepage": "https://github.com/Geng-zy/aurabot-qq-mac",
  "engines": {
    "node": ">=22.13.0"
  }
}
